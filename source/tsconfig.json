{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "lib": ["ES2022"],
    "rootDir": "src", "outDir": "out", "strict": true, "sourceMap": true,
    "noUnusedLocals": true, "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
